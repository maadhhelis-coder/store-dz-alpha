# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
# باستثناء القوالب التوثيقية بلا أسرار حقيقية — يجب أن تبقى هذه الأسطر بعد كل أنماط ".env*"
# أعلاه (اثنان مكرَّران فعليًا فهذا الملف) وإلا يُهمَل النفي.
!.env.docker.example
# اكتُشف فعليًا (Deployment Audit MED-02): هذا الملف لم يكن مُتتبَّعًا فـgit إطلاقًا رغم أنه
# القالب الوحيد الموثَّق لمتغيرات البيئة المحلية — أي مطوّر يستنسخ المستودع لا يجد هذا الملف
# فعليًا. الآن مُستثنى صراحة فيُلتَزم به.
!.env.local.example
