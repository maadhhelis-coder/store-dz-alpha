# قالب متغيرات البيئة لـ docker compose — انسخه إلى ".env.docker" (مُستثنى من git تلقائيًا
# عبر نمط .env* فـ.gitignore) واملأ القيم الحقيقية. لا تضع أسرارًا حقيقية فهذا الملف نفسه.
#
# الاستعمال: docker compose --env-file .env.docker up --build

# ---- قاعدة البيانات (حاوية Postgres محلية — راجع service "db" فـdocker-compose.yml) ----
POSTGRES_USER=storedz
POSTGRES_PASSWORD=storedz
POSTGRES_DB=storedz

# ---- Supabase Auth (تسجيل دخول لوحة التحكم /admin) — مشروع Supabase حقيقي، لا بديل محلي له ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- تشفير الأسرار المحفوظة بقاعدة البيانات (توكنات Meta/TikTok وغيرها) ----
# أي نص عشوائي طويل يكفي محليًا؛ فالإنتاج الحقيقي يجب أن يكون سرًا مُدارًا فعليًا.
SECRETS_ENCRYPTION_KEY=local-dev-only-change-me-in-real-deployments

# ---- Upstash Redis (حد المعدل rate limiting) ----
# محليًا/فCI: تُشير لخدمة serverless-redis-http الوسيطة (facade) داخل docker-compose.yml —
# راجع service "redis-http" — التي تُترجم بروتوكول REST الذي يتكلمه عميل @upstash/redis
# الحقيقي إلى Redis عادي (service "redis"). القيمتان أدناه تطابقان الإعداد الافتراضي
# فdocker-compose.yml ولا حاجة لتغييرهما محليًا.
UPSTASH_REDIS_REST_URL=http://redis-http:80
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# ---- متفرقات ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ORDER_ENDPOINT=
CRON_SECRET=local-dev-cron-secret
