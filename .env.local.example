# انسخ هذا الملف باسم .env.local وضع القيم الحقيقية

# راجع GOOGLE_SHEETS_SETUP.md للحصول على هذا الرابط
NEXT_PUBLIC_ORDER_ENDPOINT=

# راجع BACKEND_SETUP.md للحصول على كل القيم التالية
DATABASE_URL=
# مطلوب لأوامر Prisma CLI (migrate dev/deploy) — راجع prisma.config.ts. غالبًا نفس قيمة
# DATABASE_URL محليًا؛ في الإنتاج على Supabase يكون منفذًا مختلفًا (session pooler 5432
# بدل transaction pooler 6543) — راجع prisma/MIGRATIONS.md.
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# مفتاح تشفير الأسرار المخزَّنة بقاعدة البيانات (توكنات Meta/TikTok/Gmail/شركات التوصيل).
# أي نص عشوائي طويل يكفي — ولّده مثلًا بـ: openssl rand -base64 32
# بدون هذا المتغيّر، تُحفظ هذه الأسرار بلا تشفير (تعمل الميزات بشكل طبيعي لكن بلا حماية إضافية).
SECRETS_ENCRYPTION_KEY=

# دومينك النهائي بمجرد شرائه (بلا شرطة مائلة فالنهاية) — بدونه يبقى الموقع يستعمل رابط
# Vercel الافتراضي فكل الروابط الداخلية والـsitemap.
NEXT_PUBLIC_SITE_URL=

# سرّ يتحقق منه Vercel Cron تلقائيًا عند استدعاء /api/cron/sync-ads (يُرسله Vercel نفسه
# فترويسة Authorization إذا ضُبط هذا المتغيّر) — يمنع أي طرف خارجي من استدعاء المزامنة يدويًا.
CRON_SECRET=
